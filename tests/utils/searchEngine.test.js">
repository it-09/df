import { describe, it, expect } from 'vitest';
import { searchWeb } from '../../src/utils/searchEngine.js';

describe('searchWeb', () => {
  it('should return results from DuckDuckGo or Bing', async () => {
    // Skipping this test in CI because it requires internet
    if (process.env.CI) return;

    const results = await searchWeb('site:reddit.com reddit', 3);
    console.log('searchWeb returned', results.length, 'results');
    expect(results.length).toBeGreaterThanOrEqual(0); // Can be 0 if rate limited
  });
});